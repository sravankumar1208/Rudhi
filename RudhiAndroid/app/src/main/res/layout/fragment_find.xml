<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Title & GPS coordinates -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Find Hospitals &amp; Banks"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_gps_coords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="📍 13.0827° N, 80.2707° E"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

    </RelativeLayout>

    <!-- Search Input & Filter Icon -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/border_color">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/iv_search_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="Search"
                android:src="@drawable/ic_find"
                app:tint="@color/text_secondary" />

            <EditText
                android:id="@+id/et_search_hospital"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/iv_filter_icon"
                android:layout_toEndOf="@id/iv_search_icon"
                android:background="@null"
                android:hint="Search hospital by name or area..."
                android:paddingHorizontal="10dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/placeholder_text"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/iv_filter_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="Filter"
                android:src="@drawable/ic_bell"
                app:tint="@color/primary" />

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Hospitals List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_hospitals"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>