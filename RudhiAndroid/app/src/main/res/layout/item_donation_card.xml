<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/border_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_badge_routine"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_donation_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUG"
                android:textColor="@color/success"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_donation_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="29"
                android:textColor="@color/neutral_dark"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_donation_hospital"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stanley Medical College"
                android:textColor="@color/neutral_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_donation_units"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="1 Unit Donated"
                android:textColor="@color/neutral_mid"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_donation_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_routine"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="VERIFIED"
            android:textColor="@color/success"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
