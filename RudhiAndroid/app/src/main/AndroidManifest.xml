<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.rudhi.app">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <application
        android:name=".RudhiApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_blood_drop"
        android:label="Rudhi"
        android:roundIcon="@drawable/ic_blood_drop"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rudhi">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="YOUR_GOOGLE_MAPS_KEY_HERE" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".ui.request.RequestBloodActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.request.RequestTrackingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.donor.DonorAlertActivity"
            android:exported="false" />

        <activity
            android:name=".ui.donor.DonorNavigationActivity"
            android:exported="false" />

        <activity
            android:name=".ui.donation.LogDonationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.certificate.CertificateActivity"
            android:exported="false" />

        <activity
            android:name=".ui.profile.MyDonationsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.profile.MyRequestsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />

    </application>

</manifest>
